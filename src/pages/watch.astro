---
import Layout from '../layouts/Layout.astro';
import { WatchApp } from '../components/watch/WatchApp';
---

<Layout title="Surveiller · Lumakids">
	<!--
		client:only="react" et non client:load : toute la logique dépend d'API
		navigateur (localStorage, getUserMedia, RTCPeerConnection) absentes côté
		serveur. Un rendu serveur produirait une coquille vide qu'il faudrait
		ensuite hydrater pour rien — autant ne jamais tenter le rendu serveur.
	-->
	<WatchApp client:only="react" />
</Layout>
